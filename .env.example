# Demo / local defaults. No real keys required — app runs fully on deterministic mocks.
# Copy to .env.local for local dev: cp .env.example .env.local

# Solana (optional; mocks used when unset)
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_VAULT_PROGRAM_ID=SettleNowVault111111111111111111111111111

# Supabase (optional; localStorage mock used when unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Fee / quote tuning overrides (optional, basis points / rates)
# QUOTE_BASE_BPS_LOW=120
# QUOTE_BASE_BPS_STANDARD=180
# QUOTE_BASE_BPS_HIGH=320
